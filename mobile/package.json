{
  "name": "@national-labor-platform/mobile",
  "version": "1.0.0",
  "description": "React Native mobile app for labor inspectors (iOS + Android)",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "eject": "react-native eject",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace NationalLaborPlatform.xcworkspace -scheme NationalLaborPlatform -configuration Release"
  },
  "dependencies": {
    "@national-labor-platform/sdk": "^2.0.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-community/netinfo": "^11.2.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-native-camera/camera": "^4.2.0",
    "@react-native-push-notification/push-notification": "^8.1.1",
    "@react-native-firebase/app": "^20.0.0",
    "@react-native-firebase/messaging": "^20.0.0",
    "@react-native-firebase/crashlytics": "^20.0.0",
    "@react-native-maps/maps": "^1.7.0",
    "@react-native-geolocation/geolocation": "^3.3.0",
    "axios": "^1.6.7",
    "date-fns": "^3.0.0",
    "formik": "^2.4.0",
    "i18next": "^23.7.0",
    "react": "18.2.0",
    "react-i18next": "^14.0.0",
    "react-native": "0.73.0",
    "react-native-biometrics": "^3.0.1",
    "react-native-device-info": "^11.1.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.15.0",
    "react-native-image-picker": "^7.1.0",
    "react-native-localize": "^3.2.0",
    "react-native-paper": "^5.12.0",
    "react-native-reanimated": "^3.7.0",
    "react-native-safe-area-context": "^4.9.0",
    "react-native-screens": "^3.29.0",
    "react-native-svg": "^14.1.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-zip-archive": "^7.0.0",
    "react-redux": "^9.0.0",
    "@reduxjs/toolkit": "^2.0.0",
    "yup": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/runtime": "^7.23.0",
    "@react-native/babel-preset": "0.73.0",
    "@react-native/eslint-config": "0.73.0",
    "@react-native/metro-config": "0.73.0",
    "@react-native/typescript-config": "0.73.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "@types/react-native-vector-icons": "^6.4.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.1.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEach": [
      "@testing-library/jest-native/extend-expect"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}