# ============================================================
# UnionSphere Enterprise — Production Environment Configuration
# Ministry of Social Affairs and Labor — Work Sector
# ============================================================

# ---------- Database (Neon PostgreSQL) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------- Security ----------
# JWT signing secret — minimum 32 chars (recommended: 64 random hex)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cd4e797c97dea49903cfd37bbf3ffb86c3d14f4038d894fff3ab6b976b8a98d9cbc68d69735a1bdfdd6452262aefb318

# Data encryption key (AES-256-GCM) — mandatory in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=bd00ff2de460f1cd651bcba049be2863237da58d4ab9fe4a3d403bd9d906e3e8

# Backup encryption key — losing it means losing all backups
BACKUP_KEY=960330c5089b481a4eb10807ff343f2d1d9e0d922e2fbeabdd89920fa9ab5106

# ---------- Authentication ----------
ENABLE_AUTH=true
ENABLE_MFA=true
# To enforce MFA on all requests: set to 'enforced' (not 'true')
# ENABLE_MFA=enforced
# Disable CSRF protection (NEVER use in production)
DISABLE_CSRF=false

# ---------- Database ----------
DB_SSL=true
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_MAX=20
DB_POOL_MIN=3

# ---------- Server ----------
PORT=3001
NODE_ENV=production
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000

# CORS origin — set to production domain
CORS_ORIGIN=https://erp-unionministry.vercel.app

# ---------- Frontend ----------
VITE_API_BASE=/api
VITE_APP_NAME=المنظومة الوطنية للعمل النقابي
VITE_APP_VERSION=2.4.0
VITE_APP_DOMAIN=mosal.gov.ye
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_PWA=true
