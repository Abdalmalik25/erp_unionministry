@echo off
chcp 65001 > nul
title المنظومة المركزية الموحدة — وزارة الشؤون الاجتماعية والعمل

echo =========================================================================
echo    الجمهورية اليمنية — وزارة الشؤون الاجتماعية والعمل — قطاع العمل
echo    تشغيل المنظومة الموحدة محلياً (Local Desktop Mode)
echo =========================================================================
echo.

cd /d "%~dp0"

echo [1/3] فحص البيئة والخدمات المحلية...
if not exist "node_modules" (
    echo جاري تثبيت الحزم اللازمة للتشغيل المحلي لأول مرة...
    call pnpm install
)

echo [2/3] بدء تشغيل الخادم المحلي وقاعدة البيانات...
start /b cmd /c "node server/index.js"

echo [3/3] تشغيل واجهة المستخدم المحلية فائقة السرعة...
start /b cmd /c "pnpm run dev"

timeout /t 3 > nul

echo.
echo =========================================================================
echo    تم تشغيل المنظومة بنجاح!
echo    الرابط المحلي المباشر: http://localhost:5174
echo.
echo    يمكنك أيضاً تثبيت المنظومة كتطبيق سطح مكتب مستقل بالنقر على أيقونة
echo    (تثبيت التطبيق) الظاهرة في شريط عنوان المتصفح.
echo =========================================================================
echo.

start "" "http://localhost:5174"
exit
