# ============================================================
# المنظومة الوطنية للعمل النقابي — وزارة الشؤون الاجتماعية والعمل
# قالب متغيرات البيئة الرسمي (انسخ إلى .env ثم عبّئ القيم الحقيقية)
# ============================================================

# ---------- قاعدة البيانات (Neon PostgreSQL) ----------
# سلسلة الاتصال الرسمية مع SSL مطلوب
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------- الأمان ----------
# سر توقيع JWT — يجب ألا يقل عن 32 حرفاً (موصى به: 64 حرفاً عشوائياً)
# توليد: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# تشغيل المصادقة الإلزامية (يجب true في الإنتاج — الخادم يرفض الإقلاع خلاف ذلك)
ENABLE_AUTH=true

# ---------- الواجهة الأمامية ----------
VITE_API_BASE=/api
VITE_APP_NAME=المنظومة الوطنية للعمل النقابي
VITE_APP_VERSION=2.2.0
VITE_APP_DOMAIN=mosal.gov.ye
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_PWA=true

# ---------- الخادم (Express / Node >= 20) ----------
# مفتاح تشفير البيانات الشخصية (AES-256-GCM) — إلزامي في الإنتاج (بوابة P0)
# توليد: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# مفتاح تشفير النسخ الاحتياطية — فقدانُه يعني فقدانَ النسخ كلها
BACKUP_KEY=

# SSL لقاعدة البيانات (يجب true في الإنتاج)
DB_SSL=true
DB_CONNECT_TIMEOUT_MS=10000

# المصادقة وتعدد العوامل
ENABLE_AUTH=true
ENABLE_MFA=true
# إلغاء حماية CSRF (لا تستخدمه في الإنتاج أبداً)
DISABLE_CSRF=false

# الخادم
PORT=3001
LOG_LEVEL=info
# أصل مسموح للـ CORS — اضبطه على نطاق الإنتاج الرسمي
CORS_ORIGIN=https://erp-unionministry.vercel.app
