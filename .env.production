# Production environment — public (VITE_*) variables only
# These are embedded in the client bundle at build time.
# Sensitive variables (DATABASE_URL, JWT_SECRET, etc.) are set via Vercel Project Settings.

# API Configuration
VITE_API_BASE=/api

# App Configuration
VITE_APP_NAME=UnionSphere Enterprise
VITE_APP_VERSION=2.4.0
VITE_APP_DOMAIN=unionsphere.gov.ye

# Feature Flags
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_PWA=true
VITE_ENABLE_BACKUP_ENCRYPTION=true

# Security
VITE_CSP_NONCE_KEY=enterprise-csp-nonce-2026

# Supabase (optional - fallback to empty string in code)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=