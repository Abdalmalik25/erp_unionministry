# UnionSphere Enterprise - Environment Configuration
# تكوين البيئة للنظام المؤسسي

# ============================================================
# Frontend Environment Variables (Public)
# ============================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# API Configuration
VITE_API_BASE=/api

# App Configuration
VITE_APP_NAME="UnionSphere Enterprise"
VITE_APP_VERSION="2.0.0"
VITE_APP_DOMAIN=unionsphere.gov.ye

# Feature Flags
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_PWA=true
VITE_ENABLE_BACKUP_ENCRYPTION=true

# Security
VITE_CSP_NONCE_KEY=enterprise-csp-nonce-2026

# ============================================================
# Backend Environment Variables (Secret - Vercel)
# ============================================================

# Supabase Backend
SUPABASE_PROJECT_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Database
NEON_DATABASE_URL=postgresql://<connection-string>

# Security Keys
ENCRYPTION_KEY=enterprise-backup-encryption-key-2026
JWT_SECRET_KEY=<jwt-secret-for-signing>

# Monitoring
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true
ERROR_REPORTING_DSN=<sentry-dsn-if-used>

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

# Backup Configuration
BACKUP_RETENTION_DAYS=90
BACKUP_MAX_COUNT=20
BACKUP_ENCRYPT=true