!.env.example
.git
.gitignore
.vscode
.idea
.vercel
node_modules
dist
backups
*.log
sess.log
tsc_*.txt
typecheck_result.txt
compile*.txt
build_output.txt
check.txt
dbquery*_temp.mjs
docs/*.pptx
docs/*.pdf
mobile
nginx
*.md
!README.md
E2E_TEST_REPORT.md
PRODUCTION_AUDIT_REPORT.md
PRODUCTION_READINESS.md
